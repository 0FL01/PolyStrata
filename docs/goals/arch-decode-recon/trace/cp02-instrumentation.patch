+        uint64_t v = 0;
+        const char* end = s + std::strlen(s);
+        const auto r = std::from_chars(s, end, v);
+        if (r.ec != std::errc{} || r.ptr != end || v > INT64_MAX)
+            throw std::runtime_error(std::string(name) + ": expected a nonnegative token position");
+        return v;
+    }
