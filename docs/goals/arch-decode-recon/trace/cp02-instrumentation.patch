+bool Engine::trace_token_begin(int n) {
+    VisitTrace& t = *visit_trace_;
+    if (n != 1 || block_pass_ || !t.includes(pos_)) return false;
+    if (!t.timing[0][0]) {
+        for (auto& visit : t.timing) for (auto& event : visit)
+            ck(cudaEventCreateWithFlags(&event, hipEventDefault), "Inkling visit trace events");
+        for (int il = 0; il < n_layer_; ++il) {
+            const Layer& L = layers_[(size_t) il];
+            for (int e = 0; e < n_expert_; ++e)
+                if (const uint8_t* slot = L.slot[(size_t) e])
+                    t.event(VisitTrace::kSlot, pos_, il, e, slot - exp_, L.slot_bytes, L.trade);
+        }
+        for (int j = 0; j < n_swap_; ++j) {
+            Swap& s = swap_[(size_t) j];
+            const int status = s.at.load();
+            if (status != Swap::kFree) t.event(VisitTrace::kPending, pos_, s.il, s.e, j, status, s.slot - exp_);
+        }
+    }
+    ++t.serial;
+    return true;
+}
+
+void Engine::trace_visit_begin(int visit, int il, int pass) {
+    auto& t = *visit_trace_;
+    t.index = visit;
+    t.marker_error = cudaSuccess;
+    auto& v = t.rows[visit];
+    v = {};
+    v.pos = (uint64_t) pos_;
+    v.serial = t.serial;
+    v.visit = (uint8_t) visit;
+    v.layer = (uint8_t) il;
+    v.pass = (int8_t) pass;
+    v.flags = (windowed_ ? 1 : 0) | (freeze_experts_ ? 2 : 0);
+    v.host_begin = CpuExpertTiming::now_ns();
+    t.mark(VisitTrace::kBegin, st_);
+}
+
+void Engine::trace_visit_end() {
+    auto& t = *visit_trace_;
+    t.mark(VisitTrace::kEnd, st_);
+    t.active()->host_end = CpuExpertTiming::now_ns();
+    t.ready = t.index == VisitTrace::kVisits - 1;
+    t.index = -1;
+}
+
+void Engine::trace_visits_flush() {
+    auto& t = *visit_trace_;
+    t.index = -1;
+    if (!std::exchange(t.ready, false)) return;
+    for (int i = 0; i < VisitTrace::kVisits; ++i) {
+        auto& v = t.rows[i];
+        v.gpu_visit_ms = t.elapsed(i, VisitTrace::kBegin, VisitTrace::kEnd);
+        const bool gpu = std::find(std::begin(v.placement), std::end(v.placement), 1) != std::end(v.placement);
+        const auto done = gpu ? VisitTrace::kGpuEnd : VisitTrace::kSharedDone;
+        if (gpu) {
+            v.gpu_experts_ms = t.elapsed(i, VisitTrace::kGpuBegin, done);
+            v.gpu_dispatch_ms = t.elapsed(i, VisitTrace::kSharedDone, VisitTrace::kGpuBegin);
+        }
+        if (v.cpu_ready) v.gpu_join_ms = t.elapsed(i, done, VisitTrace::kCpuReady);
+    }
+    t.write(t.rows, sizeof(t.rows));
+}
