+        // kGpuBegin/kGpuEnd can run in Workers::run's non-throwing meanwhile task. Propagate a failure on the
+        // inference thread after that task joins, not from inside a worker.
+        const cudaError_t err = cudaEventRecord(timing[index][probe], cs(stream));
+        if (probe == kGpuBegin || probe == kGpuEnd) {
+            if (err != cudaSuccess) marker_error = err;
+        } else {
+            ck(err, "Inkling visit trace marker");
+        }
+    }
+    cudaError_t marker_error = cudaSuccess;
+
+    float elapsed(int v, Probe begin, Probe end) const {
+        float ms = 0;
+        ck(cudaEventElapsedTime(&ms, timing[v][begin], timing[v][end]), "Inkling visit trace timing");
+        return ms;
+    }
+};
