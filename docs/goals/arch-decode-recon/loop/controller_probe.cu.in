// Standalone one-pass A/D diagnostic, generated by generate_probe.py. No engine integration here.
#include <hip/hip_runtime.h>

#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <stdexcept>
#include <vector>

namespace {
constexpr int kThreads = 128, kRowWidth = 2304;
constexpr int kLayers = 12, kStreams = 4, kRows = kLayers * kStreams;
constexpr size_t kValues = kRows * kRowWidth;

// @PINNED_DEVICE_CODE@

__global__ void precompute(const float* bank0, const float* bank1, const float* query, float* msg, float* msg_norm) {
    const size_t row = (size_t) blockIdx.x * kRowWidth;
    // bank_only_row uses the same offset for banks and output, so use offset row pointers and a local row of 0.
    bank_only_row(bank0, bank1, query + row, msg + row, msg_norm + row, 0);
}

__global__ void apply_pair(const float* cur, const float* msg_norm, float* pair) {
    const int s = blockIdx.x;
    constexpr int kPer = kRowWidth / kThreads, kWaves = kThreads / 32;
    const int lane = threadIdx.x & 31, wave = threadIdx.x / 32;
    __shared__ float waves[kWaves];
    cur += s * kRowWidth;
    msg_norm += s * kRowWidth;
    pair += 2 * s * kRowWidth;
    float x[kPer], ss = 0.0f;
#pragma unroll
    for (int k = 0; k < kPer; ++k) {
        x[k] = cur[threadIdx.x + k * kThreads];
        ss += x[k] * x[k];
    }
    ss = wave_reduce<false>(ss);
    if (lane == 0) waves[wave] = ss;
    __syncthreads();
    if (wave == 0) {
        const float y = wave_reduce<false>(lane < kWaves ? waves[lane] : 0.f);
        if (lane == 0) waves[0] = y;
    }
    __syncthreads();
    const float sx = 1.0f / sqrtf(waves[0] / float(kRowWidth) + 1.e-6f);
#pragma unroll
    for (int k = 0; k < kPer; ++k) {
        const int i = threadIdx.x + k * kThreads;
        pair[i] = x[k] * sx;
        pair[kRowWidth + i] = msg_norm[i];
    }
}

void ck(hipError_t status) {
    if (status != hipSuccess) throw std::runtime_error(hipGetErrorString(status));
}

struct Device {
    float* p = nullptr;
    explicit Device(size_t n) { ck(hipMalloc(&p, n * sizeof(float))); }
    Device(const Device&) = delete;
    ~Device() { (void) hipFree(p); }
};

std::vector<float> read(const char* path, size_t n) {
    std::ifstream f(path, std::ios::binary);
    std::vector<float> out(n);
    if (!f.read(reinterpret_cast<char*>(out.data()), n * sizeof(float)) || f.peek() != EOF)
        throw std::runtime_error("wrong fixture length or missing file");
    return out;
}

void equal(const char* surface, const float* a, const float* b, size_t n, size_t width, size_t stride) {
    std::vector<float> x(n), y(n);
    for (int s = 0; s < kRows; ++s) {
        ck(hipMemcpy(x.data() + s * width, a + s * stride, width * sizeof(float), hipMemcpyDeviceToHost));
        ck(hipMemcpy(y.data() + s * width, b + s * stride, width * sizeof(float), hipMemcpyDeviceToHost));
    }
    if (std::memcmp(x.data(), y.data(), n * sizeof(float)) == 0) return;
    for (size_t i = 0; i < n; ++i)
        if (std::memcmp(x.data() + i, y.data() + i, sizeof(float)) != 0) {
            unsigned xb, yb;
            std::memcpy(&xb, x.data() + i, sizeof(float));
            std::memcpy(&yb, y.data() + i, sizeof(float));
            std::fprintf(stderr, "%s first mismatch: physical=%zu stream=%zu i=%zu A=%08x D=%08x\n", surface,
                         6 + i / width / kStreams, i / width % kStreams, i % width, xb, yb);
            throw std::runtime_error("bitwise parity failed");
        }
}

template<class F> double usec(int n, F f) {
    hipEvent_t a, b;
    ck(hipEventCreate(&a));
    ck(hipEventCreate(&b));
    ck(hipEventRecord(a));
    for (int i = 0; i < n; ++i) f();
    ck(hipGetLastError());
    ck(hipEventRecord(b));
    ck(hipEventSynchronize(b));
    float ms;
    ck(hipEventElapsedTime(&ms, a, b));
    ck(hipEventDestroy(a));
    ck(hipEventDestroy(b));
    return 1000. * ms / n;
}
}  // namespace

int main(int argc, char** argv) try {
    if (argc != 1 && argc != 3 && argc != 4)
        throw std::runtime_error("usage: probe [banks-current.f32 queries.f32 [iterations]]");
    int iters = argc == 4 ? std::atoi(argv[3]) : 80;
    if (iters < 1 || iters > 1000) throw std::runtime_error("iterations must be 1..1000");
    std::vector<float> banks_cur((2 + kRows) * kRowWidth), queries(kValues);
    if (argc >= 3) {
        banks_cur = read(argv[1], banks_cur.size());
        queries = read(argv[2], queries.size());
    } else {
        unsigned seed = 0x82456d81u;
        for (auto* v : {&banks_cur, &queries})
            for (float& x : *v) {
                seed = 1664525u * seed + 1013904223u;
                x = (float)(int(seed >> 16) - 32768) / 32768.f;
            }
    }
    Device bc(banks_cur.size()), query(kValues), raw_a(kValues), raw_d(kValues), norm_d(kValues);
    Device pair_a(2 * kValues), pair_d(2 * kValues);
    ck(hipMemcpy(bc.p, banks_cur.data(), banks_cur.size() * sizeof(float), hipMemcpyHostToDevice));
    ck(hipMemcpy(query.p, queries.data(), queries.size() * sizeof(float), hipMemcpyHostToDevice));
    const float *b0 = bc.p, *b1 = b0 + kRowWidth, *cur = b1 + kRowWidth;
    auto original = [&] {
        for (int i = 0; i < kRows; i += kStreams) {
            Control3 c{};
            for (int s = 0; s < 3; ++s) {
                const size_t off = (i + s) * kRowWidth;
                c.query[s] = query.p + off;
                c.cur[s] = bc.p + 2 * kRowWidth + off;
                c.msg[s] = raw_a.p + off;
                c.pair[s] = pair_a.p + 2 * off;
            }
            control_in3_kernel<<<dim3(1, 3), kThreads>>>(b0, b1, c);
            const size_t off = (i + 3) * kRowWidth;
            control_in_kernel<<<1, kThreads>>>(b0, b1, query.p + off, cur + off, raw_a.p + off, pair_a.p + 2 * off);
        }
    };
    auto prepass = [&] { precompute<<<kRows, kThreads>>>(b0, b1, query.p, raw_d.p, norm_d.p); };
    auto finish = [&] {
        for (int i = 0; i < kRows; i += kStreams) {
            const size_t off = i * kRowWidth;
            apply_pair<<<3, kThreads>>>(cur + off, norm_d.p + off, pair_d.p + 2 * off);
            apply_pair<<<1, kThreads>>>(cur + off + 3 * kRowWidth, norm_d.p + off + 3 * kRowWidth,
                                       pair_d.p + 2 * (off + 3 * kRowWidth));
        }
    };
    original();
    prepass();
    finish();
    ck(hipGetLastError());
    ck(hipDeviceSynchronize());
    equal("raw message", raw_a.p, raw_d.p, kValues, kRowWidth, kRowWidth);
    equal("message norm", pair_a.p + kRowWidth, pair_d.p + kRowWidth, kValues, kRowWidth, 2 * kRowWidth);
    equal("current norm", pair_a.p, pair_d.p, kValues, kRowWidth, 2 * kRowWidth);
    for (int i = 0; i < 6; ++i) {
        double a, d;
        auto d_all = [&] { prepass(); finish(); };
        if (i % 2 == 0) a = usec(iters, original), d = usec(iters, d_all);
        else d = usec(iters, d_all), a = usec(iters, original);
        std::printf("%s pair=%d A=%.3f D=%.3f us/pass\n", argc >= 3 ? "fixture" : "synthetic", i, a, d);
    }
    const double prep = usec(iters, prepass), apply = usec(iters, finish);
    std::printf("PASS (48 streams, raw message and both pair halves); hot prepass=%.3f apply=%.3f us/pass\n", prep, apply);
    return 0;
} catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 1;
}
