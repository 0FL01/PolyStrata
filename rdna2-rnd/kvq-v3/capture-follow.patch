+// KVQ research: per-request forced tokens and a logit log (top-K + log-sum-exp per picked step).
+static std::string g_kvq_follow, g_kvq_logits;
+static int g_kvq_top = 256;
+static std::vector<int32_t> g_kvq_ids;
+static FILE* g_kvq_out = nullptr;
+static void kvq_log(const float* logits, int n_vocab, int32_t forced, int64_t step) {
+    if (!g_kvq_out) return;
+    const int k = std::min(g_kvq_top, n_vocab);
+    std::vector<int> order((size_t) n_vocab);
+    for (int i = 0; i < n_vocab; ++i) order[(size_t) i] = i;
+    std::partial_sort(order.begin(), order.begin() + k, order.end(),
+                      [logits](int a, int b) { return logits[a] > logits[b]; });
+    const double top = logits[order[0]];
+    double sum = 0.0;
+    for (int i = 0; i < n_vocab; ++i) sum += std::exp((double) logits[i] - top);
+    const double lse = top + std::log(sum);
+    const int64_t hdr[2] = {step, (int64_t) forced};
+    std::fwrite(hdr, sizeof hdr, 1, g_kvq_out);
+    const float f[2] = {(float) lse, forced >= 0 && forced < n_vocab ? logits[forced] : -1e30f};
+    std::fwrite(f, sizeof f, 1, g_kvq_out);
+    for (int i = 0; i < k; ++i) {
+        const int32_t id = order[(size_t) i];
+        std::fwrite(&id, 4, 1, g_kvq_out);
+        std::fwrite(&logits[id], 4, 1, g_kvq_out);
+    }
+}
